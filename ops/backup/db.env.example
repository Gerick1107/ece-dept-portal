# MySQL credentials for the backup container (must match the portal DB).
# Copy to db.env — never commit real passwords.
#
# Change these to match .env.docker exactly:
#   MYSQL_PASSWORD
#   MYSQL_ROOT_PASSWORD
# MYSQL_USER / MYSQL_DATABASE usually stay as below.
MYSQL_USER=portal_user
MYSQL_PASSWORD=replace_with_strong_portal_password
MYSQL_DATABASE=ece_dept_portal
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
