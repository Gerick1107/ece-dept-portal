# =============================================================================
# ECE Portal backup service — copy to bac.env and edit before first run.
# Never commit bac.env (it holds the restic encryption password).
# =============================================================================

# Source paths inside the backup container (match docker-compose.backup.yml mounts).
STORAGE_SOURCE=/source/storage
DOCUMENTS_SOURCE=/source/documents
ASSETS_SOURCE=/source/assets
TEMPLATES_SOURCE=/source/templates

# Location where logical MySQL dumps are written before restic snapshots them.
MYSQL_DUMP_ROOT=/backup-root/mysql-logical

# MySQL connection for consistent logical dumps.
# Password is provided from db.env via docker-compose env_file.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=portal_user
MYSQL_DATABASE=ece_dept_portal

# Mounted backup root inside the backup container.
BACKUP_ROOT=/backup-root

# How often backups should run (in days).
BACKUP_INTERVAL_DAYS=1

# Daily backup start time in 24-hour format (1:00 PM).
BACKUP_START_TIME=13:00

# Backup host label used in restic snapshots.
BACKUP_HOST_LABEL=ece-portal

# Restic repository encryption password (AES).
# Generate a long random value, e.g.: openssl rand -base64 48
# IMPORTANT: store this offline — without it you cannot restore.
RESTIC_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Legacy alias (leave blank when RESTIC_PASSWORD is set).
BACKUP_ENCRYPTION_PASSWORD=

# Host path mounted as /backup-root (override in shell or .env before compose).
BACKUP_TARGET_PATH=./backup-data
